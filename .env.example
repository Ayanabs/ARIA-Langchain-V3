# Copy to .env and fill in credentials. Never commit .env.
# Addresses below are the shared test environment (see BUILD_PLAN.md).

HOST=0.0.0.0
PORT=8002
LOG_LEVEL=INFO
# Deployment configuration (models' capability profiles, limits, paths).
ARIA_CONFIG_FILE=config/aria.yaml

SPRING_BOOT_BASE_URL=http://192.168.84.190:8080

# Tool / routing model (OpenAI-compatible endpoint plus the provider's native API,
# which is used where the context length must be set per request).
OPENAI_API_BASE=https://colab.require.help/v1
OPENAI_API_KEY=
MODEL_NAME=qwen2.5:7b
MODEL_NATIVE_API_BASE=https://colab.require.help

# Synthesis model.
GENERAL_OPENAI_API_BASE=https://colab.require.help/v1
GENERAL_OPENAI_API_KEY=
GENERAL_MODEL_NAME=llama3.1:8b
GENERAL_MODEL_NATIVE_API_BASE=https://colab.require.help

EMBEDDING_API_BASE=http://192.168.84.190:11434
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=bge-m3

RAG_SERVICE_URL=http://192.168.84.190:8082/api/search
NER_SERVICE_URL=http://192.168.84.190:8009/extract
CROSS_ENCODER_HOST=192.168.84.190
CROSS_ENCODER_PORT=8006

REDIS_HOST=192.168.84.190
REDIS_PORT=6379
REDIS_PASSWORD=

CHATS_DB_HOST=192.168.84.190
CHATS_DB_PORT=5430
CHATS_DB_NAME=aria_chats_db
CHATS_DB_USER=
CHATS_DB_PASSWORD=

PROMPTS_DB_HOST=192.168.84.190
PROMPTS_DB_PORT=5433
PROMPTS_DB_NAME=aria_prompts_db
PROMPTS_DB_USER=
PROMPTS_DB_PASSWORD=

# Optional model review of answers; code checks always run.
ARIA_RESPONSE_VALIDATION_ENABLED=false
